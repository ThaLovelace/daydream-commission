# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"

# Production (Postgres, e.g. Neon or Supabase free tier):
# 1. Change "provider" in prisma/schema.prisma from "sqlite" to "postgresql"
# 2. Paste your connection string here (and in your Vercel project's Environment Variables)
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
